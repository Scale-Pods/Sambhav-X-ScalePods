# Copy to .env.local (local) or add in Vercel > Settings > Environment Variables.
# Supabase > Connect > "Transaction pooler" connection string (port 6543) is best on Vercel.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECTREF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI keys. Anthropic reads the documents and answers questions; OpenAI is optional (its models show in the model list once the key is set).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: which model each screen starts on (a model id from src/lib/ask/models.ts). Defaults shown.
# ASK_DEFAULT_MODEL=claude-haiku-5-5     the Digital Brain
# AI_MODE_MODEL=claude-haiku-5-5         AI mode in the search bar
# THINK_HARDER_MODEL=claude-sonnet-5-5   the "Think harder" button of AI mode
# AUTO_TIER1_MODEL=gpt-6-luna            Auto mode, simple questions
# AUTO_TIER2_MODEL=gpt-6.1-terra         Auto mode, harder questions
# AUTO_TIER3_MODEL=claude-sonnet-5-5     Auto mode, the hardest (owner and administrators only)
